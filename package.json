{
  "name": "@tssuite/template-project-app",
  "version": "0.0.2",
  "description": "tssuite template for browser apps incl. Playwright e2e tests and screenshot snapshots",
  "homepage": "https://github.com/tssuite/template-project-app",
  "bugs": "https://github.com/tssuite/template-project-app/issues",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/template-project-app.git"
  },
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "tsc && npx vite build",
    "prebuild": "pnpm run test",
    "preview": "npx vite preview",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:snapshots",
    "test:unit": "npx vitest run --coverage && pnpm run lint",
    "test:e2e": "npx playwright test",
    "test:snapshots": "npx playwright test --update-snapshots",
    "lint": "npx prettier --write . && npx eslint --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tssuite/dna-tssuite": "^0.1.1",
    "@tssuite/helix-js": "^0.1.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.3.3",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
